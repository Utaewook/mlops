# cp .env.example .env 로 복사해서 쓴다. .env는 git에 올라가지 않는다.
# 모든 포트는 127.0.0.1에만 열리는 로컬 실습용이지만, 비밀번호와 키는 바꿔서 쓴다.
# 값에는 영문, 숫자, -, _만 쓴다. 비밀번호가 DB 접속 URI에 그대로 들어가서 @ : / # ? % $ 가 있으면 깨진다.
# 예: openssl rand -hex 16

# PostgreSQL: MLflow, Dagster 메타데이터
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me-postgres
MLFLOW_DB=mlflow
DAGSTER_DB=dagster

# SeaweedFS S3 관리자 키
S3_ACCESS_KEY=mlops-admin
S3_SECRET_KEY=change-me-s3-secret
MLFLOW_BUCKET=mlflow
DATA_BUCKET=data

# Grafana admin 비밀번호 (처음 뜰 때만 적용된다)
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# workspace 컨테이너가 돌 사용자. Linux에서는 `id -u`, `id -g` 값을 넣는다 (Docker Desktop은 그대로 둔다)
HOST_UID=1000
HOST_GID=1000

# 학습 컨테이너(workspace, dagster-code)의 메모리 상한. 넘으면 그 컨테이너만 종료된다.
# 최대 사용량은 LLM(Qwen3-0.6B) 약 4.1GB, Vision 약 1.1GB, Time Series 약 0.3GB.
# 세 유형(timeseries, vision, llm)을 동시에 학습하지 않는다
TRAINING_MEM_LIMIT=5g

# 호스트 포트. 이미 쓰는 포트가 있으면 바꾼다 (예: macOS는 AirPlay가 5000을 쓴다)
MLFLOW_PORT=5000
POSTGRES_PORT=5432
S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
DAGSTER_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
